        },
        "down": {
          "$value": "oklch(47% 0.11 255)",
          "$type": "color",
          "$description": "exp.girok.finance.down Light-mode support token for girok market loss color."
        },
        "flat": {
          "$value": "oklch(44% 0.015 82)",
          "$type": "color",
          "$description": "exp.girok.finance.flat Light-mode support token for girok unchanged market state."
        }
      }
    }
  }
