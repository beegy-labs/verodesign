{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "declaration": false,
    "sourceMap": false,
    "esModuleInterop": true,
    "types": ["node"],
    "typeRoots": ["../../node_modules/.pnpm/@types+node@25.6.0/node_modules/@types"],
    "skipLibCheck": true,
    "resolveJsonModule": false
  },
  "include": ["src/**/*.ts"]
}
