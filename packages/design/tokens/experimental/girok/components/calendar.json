{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "exp": {
    "girok": {
      "calendar": {
        "scale": {
          "$value": 1,
          "$type": "number",
          "$description": "calendar component density scale."
        },
        "cell-size": {
          "$value": "calc(1.75rem * var(--vds-exp-girok-calendar-scale))",
          "$type": "dimension",
          "$description": "Calendar day size."
        },
        "cell-min-height": {
          "$value": "calc(2.75rem * var(--vds-exp-girok-calendar-scale))",
          "$type": "dimension",
          "$description": "Calendar cell minimum height."
        },
        "weekday-size": {
          "$value": "calc(0.6875rem * var(--vds-exp-girok-calendar-scale))",
          "$type": "dimension",
          "$description": "Calendar weekday size."
        },
        "number-size": {
          "$value": "calc(0.875rem * var(--vds-exp-girok-calendar-scale))",
          "$type": "dimension",
          "$description": "Calendar date size."
        },
        "dot-size": {
          "$value": "calc(4px * var(--vds-exp-girok-calendar-scale))",
          "$type": "dimension",
          "$description": "Calendar dot size."
        },
        "dot-gap": {
          "$value": "calc(0.25rem * var(--vds-exp-girok-calendar-scale))",
          "$type": "dimension",
          "$description": "Calendar dot gap."
        },
        "row-gap": {
          "$value": "calc(1.375rem * var(--vds-exp-girok-calendar-scale))",
          "$type": "dimension",
          "$description": "Calendar row gap."
        },
        "weekdays-wrap-min-height": {
          "$value": "calc(2.5rem * var(--vds-exp-girok-calendar-scale))",
          "$type": "dimension",
          "$description": "Calendar weekday header min height."
        },
        "cell-padding-top": {
          "$value": "calc(0.25rem * var(--vds-exp-girok-calendar-scale))",
          "$type": "dimension",
          "$description": "Calendar cell padding top."
        },
        "min-height-1": {
          "$value": "calc(2.5rem * var(--vds-exp-girok-calendar-scale))",
          "$type": "dimension",
          "$description": "calendar min-height token."
        },
        "font-size-2": {
          "$value": "calc(0.6875rem * var(--vds-exp-girok-calendar-scale))",
          "$type": "dimension",
          "$description": "calendar font-size token."
        },
        "min-height-3": {
          "$value": "calc(2.75rem * var(--vds-exp-girok-calendar-scale))",
          "$type": "dimension",
          "$description": "calendar min-height token."
        },
        "padding-top-4": {
          "$value": "calc(0.25rem * var(--vds-exp-girok-calendar-scale))",
          "$type": "dimension",
          "$description": "calendar padding-top token."
        },
        "font-size-5": {
          "$value": "calc(0.875rem * var(--vds-exp-girok-calendar-scale))",
          "$type": "dimension",
          "$description": "calendar font-size token."
        },
        "weekday-weight": {
          "$value": 700,
          "$type": "number",
          "$description": "Calendar weekday weight."
        },
        "number-weight": {
          "$value": 700,
          "$type": "number",
          "$description": "Calendar number weight."
        },
        "dot-color": {
          "$value": "{exp.girok.nav.tab-active}",
          "$type": "color",
          "$description": "Calendar dot color."
        },
        "weekday-color": {
          "$value": "{theme.text.dim}",
          "$type": "color",
          "$description": "Calendar weekday color."
        },
        "weekdays-margin-top": {
          "$value": "calc(0.5rem * var(--vds-exp-girok-calendar-scale))",
          "$type": "dimension",
          "$description": "Calendar weekday margin top."
        },
        "weekdays-margin-bottom": {
          "$value": "calc(1rem * var(--vds-exp-girok-calendar-scale))",
          "$type": "dimension",
          "$description": "Calendar weekday margin bottom."
        },
        "weekend-sat": {
          "$value": "oklch(71.37% 0.1434 254.62)",
          "$type": "color",
          "$description": "Calendar saturday color."
        },
        "weekend-sun": {
          "$value": "oklch(71.92% 0.169 13.43)",
          "$type": "color",
          "$description": "Calendar sunday color."
        },
        "selected-bg": {
          "$value": "{exp.girok.surface.control-active}",
          "$type": "color",
          "$description": "Calendar selected background."
        },
        "selected-fg": {
          "$value": "{exp.girok.nav.tab-active}",
          "$type": "color",
          "$description": "Calendar selected foreground."
        },
        "selected-border": {
          "$value": "{exp.girok.border.active}",
          "$type": "color",
          "$description": "Calendar selected border."
        },
        "today-bg": {
          "$value": "oklch(26.9% 0.026 76)",
          "$type": "color",
          "$description": "Calendar today background."
        },
        "today-fg": {
          "$value": "{exp.girok.nav.tab-active}",
          "$type": "color",
          "$description": "Calendar today foreground."
        },
        "today-border": {
          "$value": "oklch(37.5% 0.04 77)",
          "$type": "color",
          "$description": "Calendar today border."
        }
      }
    }
  }
}
