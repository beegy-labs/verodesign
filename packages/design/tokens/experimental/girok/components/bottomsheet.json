{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "exp": {
    "girok": {
      "bottomsheet": {
        "scale": {
          "$value": 1,
          "$type": "number",
          "$description": "bottomsheet component density scale."
        },
        "width-1": {
          "$value": "min(100%, calc(24.5625rem * var(--vds-exp-girok-bottomsheet-scale)))",
          "$type": "other",
          "$description": "bottomsheet width token."
        },
        "width-2": {
          "$value": "calc(2.5rem * var(--vds-exp-girok-bottomsheet-scale))",
          "$type": "dimension",
          "$description": "bottomsheet width token."
        },
        "height-3": {
          "$value": "calc(0.25rem * var(--vds-exp-girok-bottomsheet-scale))",
          "$type": "dimension",
          "$description": "bottomsheet height token."
        },
        "font-size-4": {
          "$value": "calc(10px * var(--vds-exp-girok-bottomsheet-scale))",
          "$type": "dimension",
          "$description": "bottomsheet font-size token."
        }
      }
    }
  }
}
