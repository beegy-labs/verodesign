      "since": "v0.1.0",
      "concept": "Verde Nexus — bio-emerald vibrancy",
      "primary": "OKLCH(72% 0.16 165) Bio-Emerald",
      "accent": "OKLCH(70% 0.136 180) Teal-bright"
    }
  },
  "theme": {
    "bg": {
      "page": {
        "$value": "{color.slate.12}",
        "$type": "color"
      },
      "card": {
        "$value": "{color.slate.11}",
        "$type": "color"
      },
      "elevated": {
        "$value": "{color.slate.10}",
        "$type": "color"
      },
