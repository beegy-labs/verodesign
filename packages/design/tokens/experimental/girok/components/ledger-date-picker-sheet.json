{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "exp": {
    "girok": {
      "ledger-date-picker-sheet": {
        "scale": {
          "$value": 1,
          "$type": "number",
          "$description": "ledger-date-picker-sheet component density scale."
        },
        "padding-bottom-1": {
          "$value": "calc(34px * var(--vds-exp-girok-ledger-date-picker-sheet-scale))",
          "$type": "dimension",
          "$description": "ledger-date-picker-sheet padding-bottom token."
        },
        "box-shadow-2": {
          "$value": "0 calc(-10px * var(--vds-exp-girok-ledger-date-picker-sheet-scale)) calc(40px * var(--vds-exp-girok-ledger-date-picker-sheet-scale)) var(--vds-exp-girok-redesign-surface-backdrop-medium)",
          "$type": "other",
          "$description": "ledger-date-picker-sheet box-shadow token."
        },
        "inline-size-3": {
          "$value": "calc(3rem * var(--vds-exp-girok-ledger-date-picker-sheet-scale))",
          "$type": "dimension",
          "$description": "ledger-date-picker-sheet inline-size token."
        },
        "block-size-4": {
          "$value": "calc(var(--vds-exp-girok-spacing-xs) * var(--vds-exp-girok-ledger-date-picker-sheet-scale))",
          "$type": "dimension",
          "$description": "ledger-date-picker-sheet block-size token."
        },
        "font-size-5": {
          "$value": "calc(0.875rem * var(--vds-exp-girok-ledger-date-picker-sheet-scale))",
          "$type": "dimension",
          "$description": "ledger-date-picker-sheet font-size token."
        },
        "padding-6": {
          "$value": "calc(var(--vds-exp-girok-spacing-sm) * var(--vds-exp-girok-ledger-date-picker-sheet-scale)) calc(var(--vds-exp-girok-spacing-md) * var(--vds-exp-girok-ledger-date-picker-sheet-scale))",
          "$type": "other",
          "$description": "ledger-date-picker-sheet padding token."
        },
        "font-size-7": {
          "$value": "calc(var(--vds-exp-girok-spacing-md) * var(--vds-exp-girok-ledger-date-picker-sheet-scale))",
          "$type": "dimension",
          "$description": "ledger-date-picker-sheet font-size token."
        },
        "font-size-8": {
          "$value": "calc(var(--vds-exp-girok-spacing-md) * var(--vds-exp-girok-ledger-date-picker-sheet-scale))",
          "$type": "dimension",
          "$description": "ledger-date-picker-sheet font-size token."
        },
        "font-size-9": {
          "$value": "calc(0.6875rem * var(--vds-exp-girok-ledger-date-picker-sheet-scale))",
          "$type": "dimension",
          "$description": "ledger-date-picker-sheet font-size token."
        },
        "padding-10": {
          "$value": "calc(var(--vds-exp-girok-spacing-md) * var(--vds-exp-girok-ledger-date-picker-sheet-scale))",
          "$type": "dimension",
          "$description": "ledger-date-picker-sheet padding token."
        },
        "font-size-11": {
          "$value": "calc(var(--vds-exp-girok-spacing-md) * var(--vds-exp-girok-ledger-date-picker-sheet-scale))",
          "$type": "dimension",
          "$description": "ledger-date-picker-sheet font-size token."
        },
        "box-shadow-12": {
          "$value": "0 calc(4px * var(--vds-exp-girok-ledger-date-picker-sheet-scale)) calc(14px * var(--vds-exp-girok-ledger-date-picker-sheet-scale)) var(--vds-exp-girok-redesign-accent-glow-soft)",
          "$type": "other",
          "$description": "ledger-date-picker-sheet box-shadow token."
        }
      }
    }
  }
}
