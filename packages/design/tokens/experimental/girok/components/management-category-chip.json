{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "exp": {
    "girok": {
      "management-category-chip": {
        "scale": {
          "$value": 1,
          "$type": "number",
          "$description": "management-category-chip component density scale."
        },
        "font-size-1": {
          "$value": "calc(var(--vds-exp-girok-spacing-sm) * var(--vds-exp-girok-management-category-chip-scale))",
          "$type": "dimension",
          "$description": "management-category-chip font-size token."
        },
        "gap-2": {
          "$value": "calc(var(--vds-exp-girok-spacing-xs) * var(--vds-exp-girok-management-category-chip-scale))",
          "$type": "dimension",
          "$description": "management-category-chip gap token."
        },
        "padding-3": {
          "$value": "calc(0.25rem * var(--vds-exp-girok-management-category-chip-scale)) calc(0.5rem * var(--vds-exp-girok-management-category-chip-scale))",
          "$type": "other",
          "$description": "management-category-chip padding token."
        },
        "font-size-4": {
          "$value": "calc(0.6875rem * var(--vds-exp-girok-management-category-chip-scale))",
          "$type": "dimension",
          "$description": "management-category-chip font-size token."
        }
      }
    }
  }
}
