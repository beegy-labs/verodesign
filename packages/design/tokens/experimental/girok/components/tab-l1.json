{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "exp": {
    "girok": {
      "tab-l1": {
        "scale": {
          "$value": 1,
          "$type": "number",
          "$description": "tab-l1 component density scale."
        },
        "font-size": {
          "$value": "calc(0.9375rem * var(--vds-exp-girok-tab-l1-scale))",
          "$type": "dimension",
          "$description": "Tab L1 font size."
        },
        "padding-x": {
          "$value": "calc(1rem * var(--vds-exp-girok-tab-l1-scale))",
          "$type": "dimension",
          "$description": "Tab L1 inline padding."
        },
        "padding-y": {
          "$value": "calc(var(--vds-exp-girok-spacing-sm) * var(--vds-exp-girok-tab-l1-scale))",
          "$type": "dimension",
          "$description": "Tab L1 block padding."
        },
        "min-width": {
          "$value": "calc(4rem * var(--vds-exp-girok-tab-l1-scale))",
          "$type": "dimension",
          "$description": "Tab L1 minimum width."
        },
        "scroll-padding-x": {
          "$value": "calc(0.5rem * var(--vds-exp-girok-tab-l1-scale))",
          "$type": "dimension",
          "$description": "Tab L1 scroll inline padding."
        },
        "underline-inset": {
          "$value": "calc(0.5rem * var(--vds-exp-girok-tab-l1-scale))",
          "$type": "dimension",
          "$description": "Tab L1 underline inset."
        },
        "underline-height": {
          "$value": "calc(3px * var(--vds-exp-girok-tab-l1-scale))",
          "$type": "dimension",
          "$description": "Tab L1 underline height."
        },
        "weight-active": {
          "$value": 600,
          "$type": "number",
          "$description": "Tab L1 active weight."
        },
        "weight-inactive": {
          "$value": 600,
          "$type": "number",
          "$description": "Tab L1 inactive weight."
        },
        "weight": {
          "active": {
            "$value": 600,
            "$type": "number",
            "$description": "Tab L1 active weight."
          },
          "inactive": {
            "$value": 600,
            "$type": "number",
            "$description": "Tab L1 inactive weight."
          }
        },
        "underline-glow": {
          "$value": "none",
          "$type": "shadow",
          "$description": "Tab L1 underline glow."
        }
      }
    }
  }
}
