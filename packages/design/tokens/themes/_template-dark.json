{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$extensions": {
    "verobee": {
      "tier": "theme",
      "theme": "TEMPLATE",
      "mode": "dark",
      "implements": [
        "core",
        "web"
      ],
      "since": "v0.X.Y",
      "concept": "Replace with brand concept (1 line)",
      "primary": "OKLCH(L% C H) BrandName"
    }
  },
  "theme": {
    "bg": {
      "page": {
        "$value": "{color.slate.12}",
        "$type": "color"
      },
      "card": {
        "$value": "{color.slate.11}",
        "$type": "color"
      },
      "elevated": {
        "$value": "{color.slate.10}",
        "$type": "color"
      },
      "hover": {
        "$value": "{color.slate.10}",
        "$type": "color"
      },
      "muted": {
        "$value": "{color.slate.9}",
        "$type": "color"
      },
      "inverse": {
        "$value": "{color.slate.1}",
        "$type": "color"
      },
      "selected": {
        "$value": "{color.slate.9}",
        "$type": "color"
      }
    },
    "text": {
      "primary": {
        "$value": "{color.slate.1}",
        "$type": "color"
      },
      "secondary": {
        "$value": "{color.slate.3}",
        "$type": "color"
      },
      "dim": {
        "$value": "{color.slate.5}",
        "$type": "color"
      },
      "faint": {
        "$value": "{color.slate.7}",
        "$type": "color",
        "$extensions": {
          "verobee": {
            "contrast": {
              "allow": "AA-large",
              "rationale": "Hint text only"
            }
          }
        }
      },
      "bright": {
        "$value": "{color.white}",
        "$type": "color"
      },
      "inverse": {
        "$value": "{color.slate.11}",
        "$type": "color"
      }
    },
    "border": {
      "subtle": {
        "$value": "{color.slate.10}",
        "$type": "color"
      },
      "default": {
        "$value": "{color.slate.9}",
        "$type": "color"
      },
      "strong": {
        "$value": "{color.slate.6}",
        "$type": "color"
      },
      "focus": {
        "$value": "oklch(70% 0.16 240)",
        "$type": "color"
      }
    },
    "primary": {
      "$root": {
        "$value": "oklch(70% 0.16 240)",
        "$type": "color"
      },
      "foreground": {
        "$value": "oklch(12% 0.04 240)",
        "$type": "color"
      },
      "ring": {
        "$value": "oklch(82% 0.12 240)",
        "$type": "color"
      }
    },
    "chart": {
      "1": {
        "$value": "{color.blue.5}",
        "$type": "color"
      },
      "2": {
        "$value": "{color.green.5}",
        "$type": "color"
      },
      "3": {
        "$value": "{color.amber.5}",
        "$type": "color"
      },
      "4": {
        "$value": "{color.violet.5}",
        "$type": "color"
      },
      "5": {
        "$value": "{color.pink.5}",
        "$type": "color"
      }
    }
  }
}
