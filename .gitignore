# Dependencies
node_modules/

# Logs
*.log

# OS / editor cruft
.DS_Store
.idea/
.vscode/

# Env
.env
.env.local

# Tooling caches
.turbo/
*.tsbuildinfo
coverage/

# Build outputs — generated by `turbo run build` / release; never committed.
# Consumers install the published packages from the registry (built fresh in
# CI); a clone builds locally. Keeps generated churn out of git.
packages/*/dist/
packages/showcase/.astro/

# Scratch / capture artifacts (screenshots, throwaway HTML dumps, etc.).
tmp/

# Registry config is written by CI/release at runtime and may carry a token.
.npmrc

# Per-tool LLM agent files. This repo standardizes on AGENTS.md as the single
# tool-neutral entrypoint (+ .agents/ canonical skills, which ARE tracked).
# Per-tool routers (CLAUDE.md/CODEX.md/GEMINI.md) and per-tool skill mirror
# dirs are derived duplicates — not tracked.
CLAUDE.md
CODEX.md
GEMINI.md
.claude/
.codex/
.cursor/
.gemini/
.windsurf/
.aider*
.continue/

# Local secrets inbox (org standard secrets-management policy).
# NEVER commit. NEVER push. NEVER referenced from helm values / TF tfvars.
# Operator's working copy of credentials; canonical store is OpenBao + ansible-vault.
.secrets/
.secrets/**
