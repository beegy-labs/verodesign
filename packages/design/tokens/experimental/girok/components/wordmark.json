{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "exp": {
    "girok": {
      "wordmark": {
        "scale": {
          "$value": 1,
          "$type": "number",
          "$description": "wordmark component density scale."
        },
        "size": {
          "$value": "calc(1.25rem * var(--vds-exp-girok-wordmark-scale))",
          "$type": "dimension",
          "$description": "Wordmark font size."
        },
        "weight": {
          "$value": 800,
          "$type": "number",
          "$description": "Wordmark weight."
        },
        "tracking": {
          "$value": "calc(-0.055em * var(--vds-exp-girok-wordmark-scale))",
          "$type": "dimension",
          "$description": "Wordmark tracking."
        },
        "font-size-1": {
          "$value": "calc(0.9em * var(--vds-exp-girok-wordmark-scale))",
          "$type": "dimension",
          "$description": "wordmark font-size token."
        }
      }
    }
  }
}
