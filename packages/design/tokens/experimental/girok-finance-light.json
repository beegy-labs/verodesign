{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$extensions": {
    "verobee": {
      "status": "experimental",
      "since": "TBD",
      "source": "app-girok/docs/design/units/invest-positions.md, app-girok/docs/design/units/debt-loans.md, app-girok/docs/design/units/invest-snowball-hero.md",
      "implements": [
        "girok-scoped"
      ],
      "brand": "girok",
      "mode": "light"
    }
