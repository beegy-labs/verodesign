{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$extensions": {
    "verobee": {
      "tier": "primitive",
      "status": "canonical",
      "since": "v0.1.0",
      "platform": [
        "web",
        "ios",
        "android"
      ],
      "rationale": "Mobile-first restrained ramp, anchor 16px. Upper steps stay clearly hierarchical without poster-scale jumps."
    }
  },
  "font": {
    "family": {
      "sans": {
        "$value": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
        "$type": "fontFamily",
        "$description": "System default sans-serif stack"
      },
      "mono": {
        "$value": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
        "$type": "fontFamily",
        "$description": "System default monospace stack"
      }
    },
    "size": {
      "xs": {
        "$value": "0.75rem",
        "$type": "dimension",
        "$description": "12px label/caption"
      },
      "sm": {
        "$value": "0.875rem",
        "$type": "dimension",
        "$description": "14px supporting"
      },
      "base": {
        "$value": "1rem",
        "$type": "dimension",
        "$description": "16px body anchor"
      },
      "lg": {
        "$value": "1.125rem",
        "$type": "dimension",
        "$description": "18px lead body"
      },
      "xl": {
        "$value": "1.3125rem",
        "$type": "dimension",
        "$description": "21px h6/h5"
      },
      "2xl": {
        "$value": "1.75rem",
        "$type": "dimension",
        "$description": "28px h4"
      },
      "3xl": {
        "$value": "2rem",
        "$type": "dimension",
        "$description": "32px h3 / restrained section heading"
      },
      "4xl": {
        "$value": "2.375rem",
        "$type": "dimension",
        "$description": "38px h2 / page heading"
      },
      "5xl": {
        "$value": "2.75rem",
        "$type": "dimension",
        "$description": "44px h1 / restrained hero"
      },
      "6xl": {
        "$value": "3.25rem",
        "$type": "dimension",
        "$description": "52px display ceiling"
      },
      "numeric-display-sm": {
        "$value": "2.25rem",
        "$type": "dimension",
        "$description": "36px primary amount / headline metric"
      },
      "numeric-display-lg": {
        "$value": "2.75rem",
        "$type": "dimension",
        "$description": "44px hero amount / market summary metric"
      }
    },
    "weight": {
      "400": {
        "$value": 400,
        "$type": "fontWeight",
        "$description": "Regular"
      },
      "500": {
        "$value": 500,
        "$type": "fontWeight",
        "$description": "Medium"
      },
      "600": {
        "$value": 600,
        "$type": "fontWeight",
        "$description": "Semibold"
      },
      "700": {
        "$value": 700,
        "$type": "fontWeight",
        "$description": "Bold"
      }
    },
    "lineHeight": {
      "none": {
        "$value": 1,
        "$type": "number",
        "$description": "Display / icon-only"
      },
      "tight": {
        "$value": 1.25,
        "$type": "number",
        "$description": "Headings"
      },
      "snug": {
        "$value": 1.375,
        "$type": "number",
        "$description": "Subheadings"
      },
      "normal": {
        "$value": 1.5,
        "$type": "number",
        "$description": "Body default"
      },
      "relaxed": {
        "$value": 1.625,
        "$type": "number",
        "$description": "Long-form reading"
      },
      "loose": {
        "$value": 1.75,
        "$type": "number",
        "$description": "Spacious"
      }
    },
    "letterSpacing": {
      "tight": {
        "$value": "-0.02em",
        "$type": "dimension",
        "$description": "Display headings"
      },
      "snug": {
        "$value": "-0.01em",
        "$type": "dimension",
        "$description": "Headings"
      },
      "normal": {
        "$value": "0em",
        "$type": "dimension",
        "$description": "Body default"
      },
      "wide": {
        "$value": "0.01em",
        "$type": "dimension",
        "$description": "Slightly wide"
      },
      "wider": {
        "$value": "0.05em",
        "$type": "dimension",
        "$description": "All-caps labels"
      }
    }
  }
}
