{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "exp": {
    "girok": {
      "view-toggle": {
        "scale": {
          "$value": 1,
          "$type": "number",
          "$description": "view-toggle component density scale."
        },
        "min-height-1": {
          "$value": "calc(2.75rem * var(--vds-exp-girok-view-toggle-scale))",
          "$type": "dimension",
          "$description": "view-toggle min-height token."
        },
        "width-2": {
          "$value": "calc(1.625rem * var(--vds-exp-girok-view-toggle-scale))",
          "$type": "dimension",
          "$description": "view-toggle width token."
        },
        "height-3": {
          "$value": "calc(1.625rem * var(--vds-exp-girok-view-toggle-scale))",
          "$type": "dimension",
          "$description": "view-toggle height token."
        },
        "border-radius-4": {
          "$value": "calc(var(--vds-exp-girok-spacing-xs) * var(--vds-exp-girok-view-toggle-scale))",
          "$type": "dimension",
          "$description": "view-toggle border-radius token."
        },
        "width-5": {
          "$value": "calc(0.875rem * var(--vds-exp-girok-view-toggle-scale))",
          "$type": "dimension",
          "$description": "view-toggle width token."
        },
        "height-6": {
          "$value": "calc(0.875rem * var(--vds-exp-girok-view-toggle-scale))",
          "$type": "dimension",
          "$description": "view-toggle height token."
        }
      }
    }
  }
}
